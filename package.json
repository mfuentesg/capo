{
  "name": "capo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "validate": "pnpm run i18n:validate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "i18n:validate": "node lib/i18n/validate-translations.js",
    "optimize:logos": "tsx scripts/optimize-logos.ts",
    "supabase": "pnpm dlx supabase@latest",
    "types:generate": "pnpm --silent dlx supabase@latest gen types typescript --local > lib/supabase/database.types.ts"
  },
  "dependencies": {
